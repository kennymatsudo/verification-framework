{
  "practice": "ledger-legacy",
  "prepare": "bare",
  "max_user_turns": 6,
  "graders": [
    {
      "name": "report_names",
      "patterns": [
        "check_create",
        "check_transfer",
        "check_statement",
        "check_overdraft"
      ],
      "weight": 4
    },
    {
      "name": "report_names",
      "patterns": [
        "COVERAGE|strong"
