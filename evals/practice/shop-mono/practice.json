{
  "name": "shop-mono",
  "summary": "A monorepo with a Python orders service and a Node mailer that share an outbox file. The harness belongs to the orders app, so its project root is apps/orders. Running the mailer sends real mail through the team relay, a shared side effect that needs the user's approval.",
  "setup": {
    "language": "python and node",
    "shape": "monorepo, harness per app",
    "surface": "HTTP API and a worker",
    "start": "agent",
    "reload": "restart"
  },
  "requires": [
    "python3",
    "node",
    "curl"
  ],
  "ports": [
    8073
  ],
  "repos": {
    "orders": "apps/orders",
    "mailer": "apps/mailer"
  },
  "git_repos": [
    "."
  ],
  "project_root": "apps/orders",
  "harness": ".claude/skills/verify-orders",
  "requirements": "apps/orders/REQUIREMENTS.md",
  "app_code_patterns": [
    "(?m)^\\s*(from\\s+orders(\\.\\w+)?\\s+import|import\\s+orders\\b)",
    "require\\([\"'][^\"']*worker(\\.js)?[\"']\\)"
  ],
  "behaviors": {
    "orders.create": {
      "requirement": "SR-1",
      "words": "an order is stored with its lines and total",
      "match": "order.*(stor|creat|total)"
    },
    "orders.enqueue": {
      "requirement": "SR-2",
      "words": "one outbox job per order",
      "match": "outbox|queue|job"
    },
    "mail.confirmation-sent": {
      "requirement": "SR-3",
      "words": "one confirmation email per job",
      "match": "(mail|email|confirmation).*(sent|send)|sends"
    },
    "mail.marks-done": {
      "requirement": "SR-3",
      "words": "a job is marked done after sending",
      "match": "done|twice|again|mark"
    }
  },
  "open_questions": [],
  "known_bugs": {},
  "shared_side_effects": {
    "mail-sink": "the relay folder: anything written here is sent to the team's shared inbox"
  },
  "breaks": [
    {
      "patch": "breaks/01-order-stored-without-lines.patch",
      "sub_feature": "orders.create",
      "what": "an order is stored without its lines"
    },
    {
      "patch": "breaks/02-no-job-enqueued.patch",
      "sub_feature": "orders.enqueue",
      "what": "no outbox job is written for an order"
    },
    {
      "patch": "breaks/03-job-enqueued-twice.patch",
      "sub_feature": "orders.enqueue",
      "what": "two outbox jobs are written for one order"
    }
  ],
  "changes": {}
}
